# Copy this file to `.env` and fill in the value below.
# `.env` is gitignored; this template is committed for fork-ers.

# Last.fm Web Services API key.
# Free, takes a minute: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional — Spotify Web API client credentials. When both are set, Antiphon
# resolves direct track/album/artist URIs instead of search URLs. Register an
# app at https://developer.spotify.com/dashboard (Client Credentials flow).
# Missing or blank values are fine; the default search-URL path keeps working.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
